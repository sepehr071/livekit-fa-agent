# LiveKit (agent worker <-> SFU is local, never proxied)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

OPENAI_API_KEY=sk-...

# Local HTTP CONNECT proxy used ONLY for the realtime model connection
AI_PROXY=http://127.0.0.1:8118

# Retrieval endpoint (POST {"query": "..."} -> {"nodes": [{"text": "..."}]})
RAG_URL=https://rag.example.com/query
RAG_API_KEY=change-me
RAG_TIMEOUT=10
RAG_TOP_K=5
RAG_CHAR_CAP=3000

# Close the session this many seconds after the user goes silent
IDLE_GRACE_SECONDS=45
